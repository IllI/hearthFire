{
  "name": "farm-fresh-delivery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/ensure-uploads-dir.js && next build",
    "start": "next start",
    "lint": "next lint",
    "seed-db": "node scripts/seed-products.js",
    "seed-orders": "node scripts/seed-orders.js",
    "setup-rules": "node scripts/setup-firestore-rules.js",
    "use-mock-data": "node scripts/toggle-dev-mode.js --enable",
    "use-real-data": "node scripts/toggle-dev-mode.js --disable",
