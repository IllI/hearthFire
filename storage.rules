rules_version = '2';

// Craft rules based on your authentication needs
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to read any file
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }
    
    // Allow authenticated users to upload files to specific paths
    match /products/{filename} {
      allow write: if request.auth != null;
    }
    
    match /test-uploads/{filename} {
      allow write: if request.auth != null;
    }
    
    // Legacy support for older paths
    match /uploads/{allPaths=**} {
      allow write: if request.auth != null;
    }
    
    // Content images - allow authenticated users to upload and admins to delete
    match /content-images/{imageId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && 
                     (request.auth.token.admin == true || 
                      request.auth.token.role == 'admin');
    }
    
    // Product images - only admins can write, anyone can read
    match /products/{allImages=**} {
      allow read: if true;
      allow write: if request.auth != null && 
                    (request.auth.token.admin == true || 
                     request.auth.token.role == 'admin');
    }
  }
} 